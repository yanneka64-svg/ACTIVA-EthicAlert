# === AMÉLIORATION AJOUTÉE (revue PR #139) === variables des Cloud Functions.
# Copier en `functions/.env` (ignoré par git) avant `npm run deploy`.
# Les secrets (RESEND_API_KEY) vont dans Secret Manager, jamais ici :
#   firebase functions:secrets:set RESEND_API_KEY

# Obligatoire pour notifyEmail : domaines autorisés des destinataires
# (séparés par des virgules). Sans cette variable, aucun e-mail ne part.
NOTIFY_ALLOWED_RECIPIENT_DOMAINS=group-activa.com

# Facultatif : origines supplémentaires de l'application (domaine personnalisé).
NOTIFY_ALLOWED_ORIGINS=https://activa-ethicalert.group-activa.com
# Facultatif : envois d'e-mails par IP et par tranche de 10 minutes (défaut 60).
# NOTIFY_RATE_LIMIT=60
# Facultatif : e-mail d'expédition (domaine vérifié chez Resend).
# NOTIFY_FROM_EMAIL="ACTIVA EthicAlert <notifications@group-activa.com>"

# Facultatif : signalements publics créés par IP et par heure (défaut 10).
# REPORTER_CREATE_MAX_PER_HOUR=10

# À passer à true UNIQUEMENT après la mise en service d'App Check côté Web
# (docs/DEVOPS-RUNBOOK.md §3.3) : createCaseAsReporter refusera alors tout
# appel non attesté.
ENFORCE_APP_CHECK=false
