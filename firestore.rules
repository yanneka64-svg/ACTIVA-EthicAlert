rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization levels 1 - 5 (CDC 45)
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roleName) {
      return isAuthenticated() && getUserData().roleIds.hasAny([roleName]);
    }

    function isSystemAdmin() {
      return hasRole('system_admin');
    }

    function isFunctionalAdmin() {
      return hasRole('functional_admin');
    }

    function isInvestigator() {
      return hasRole('investigator');
    }

    function isAuditor() {
      return hasRole('auditor');
    }

    // Level 3 & 4: Scope and Case Assignment checks
    function isAssignedToCase(caseData) {
      return isAuthenticated() && (
        caseData.currentAssigneeId == request.auth.uid ||
        caseData.primaryInvestigatorId == request.auth.uid ||
        request.auth.uid in caseData.assignedInvestigators
      );
    }

    function hasEntityScope(caseData) {
      return isAuthenticated() && (
        isSystemAdmin() || 
        isFunctionalAdmin() ||
        getUserData().entityIds.hasAny([caseData.entityId]) ||
        getUserData().countryIds.hasAny([caseData.countryId])
      );
    }

    // --- CASES COLLECTION (CDC 48) ---
    match /cases/{caseId} {
      // Creation: Anonymous or identified submitter via controlled backend or client portal
      allow create: if request.resource.data.caseNumber != null;

      // Read: Functional admins, auditors, or assigned investigators with entity scope
      allow read: if isSystemAdmin() || isFunctionalAdmin() || isAuditor() || 
                    (isInvestigator() && isAssignedToCase(resource.data) && hasEntityScope(resource.data));

      // Update: Case transitions and field updates managed by authorized investigators/admins
      allow update: if (isFunctionalAdmin() || (isInvestigator() && isAssignedToCase(resource.data))) &&
                       request.resource.data.caseNumber == resource.data.caseNumber; // immutable ID

      // Delete: Never allowed directly (retention & legal hold policy - CDC 73)
      allow delete: if false;

      // --- SUBCOLLECTIONS ---

      // Allegations & Findings (CDC 50)
      match /allegations/{allegationId} {
        allow read: if isFunctionalAdmin() || isAuditor() || (isInvestigator() && isAssignedToCase(get(/databases/$(database)/documents/cases/$(caseId)).data));
        allow write: if isFunctionalAdmin() || (isInvestigator() && isAssignedToCase(get(/databases/$(database)/documents/cases/$(caseId)).data));
      }

      // Persons Involved - Subjects (CDC 51)
      match /subjects/{subjectId} {
        allow read, write: if isFunctionalAdmin() || isInvestigator();
      }

      // Witnesses (CDC 51)
      match /witnesses/{witnessId} {
        allow read, write: if isFunctionalAdmin() || isInvestigator();
      }

      // Evidence Metadata (CDC 52)
      match /evidence/{evidenceId} {
        allow read: if isFunctionalAdmin() || isAuditor() || isInvestigator();
        allow create, update: if isFunctionalAdmin() || isInvestigator();
        allow delete: if isFunctionalAdmin();
      }

      // Tasks (CDC 53)
      match /tasks/{taskId} {
        allow read, write: if isFunctionalAdmin() || isInvestigator();
      }

      // Investigation Notes (CDC 53) - Strictly forbidden to reporters
      match /investigation_notes/{noteId} {
        allow read, write: if isFunctionalAdmin() || isInvestigator();
      }

      // Communications (CDC 54) - Messages between Reporter and Desk
      match /communications/{messageId} {
        allow read: if true; // Controlled visibility in backend
        allow create: if true; // Reporter or Desk
        allow update, delete: if false; // Communication trail immutable
      }

      // Risk Assessments (CDC 55) - Auditable history of risk decisions
      match /risk_assessments/{assessmentId} {
        allow read: if isFunctionalAdmin() || isAuditor() || isInvestigator();
        allow create: if isFunctionalAdmin() || isInvestigator();
        allow update, delete: if false; // Risk scores must never be overwritten in-place
      }
    }

    // --- ANONYMOUS REPORTER ACCESS (CDC 49) ---
    match /reporter_access/{accessId} {
      allow read, create: if true;
      allow update: if request.resource.data.accessCodeHash == resource.data.accessCodeHash;
      allow delete: if false;
    }

    // --- REPORTER IDENTITIES (CDC 49) ---
    // Strictly separated from cases, protected against unauthorized access
    match /reporter_identities/{caseId} {
      allow read: if isFunctionalAdmin() || (isInvestigator() && request.auth.token.canViewReporterIdentity == true);
      allow create: if true;
      allow update, delete: if isSystemAdmin();
    }

    // --- CONFLICT OF INTEREST DECLARATIONS (CDC 59) ---
    match /case_conflicts/{conflictId} {
      allow read: if isFunctionalAdmin() || isAuditor() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isFunctionalAdmin(); // Only admin can record conflict resolution
      allow delete: if false;
    }

    // --- AUDIT LOGS (CDC 62) ---
    // Append-only, immutable 10-year trail
    match /audit_logs/{logId} {
      allow read: if isFunctionalAdmin() || isAuditor() || isSystemAdmin();
      allow create: if true;
      allow update, delete: if false; // Strictly forbidden
    }

    // --- NOTIFICATIONS (CDC 61) ---
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow create: if true;
      allow update: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }

    // --- USERS & ROLES (CDC 46) ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSystemAdmin();
    }

    // --- CONFIGURATION (CDC 63) ---
    match /configuration/{configDoc} {
      allow read: if true;
      allow write: if isSystemAdmin() || isFunctionalAdmin();
    }

    // --- REPORTING AGGREGATES (CDC 64) ---
    match /reporting_aggregates/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isFunctionalAdmin() || isSystemAdmin();
    }

    // === AMÉLIORATION AJOUTÉE (Phase 3) ===
    // Target normalized model (docs/DATABASE.md). Real Firebase Authentication
    // now exists (scripts/setupAuthUsers.ts) with custom claims — role,
    // countries[], entities[] — set to MIRROR src/domain/permissions.ts
    // exactly, so client and rules never disagree about who can read what.
    //
    // Mutations remain closed to the client SDK entirely (`allow write: if
    // false` throughout this block): per docs/ARCHITECTURE.md, "the client
    // never decides a sensitive mutation alone" — every write must go
    // through a Cloud Function that re-validates the workflow/permission
    // rules server-side (checkTransition, can()) before writing, the same
    // way scripts/firestoreAdminRepository.ts already does for this seed
    // script. Reads below are the exception: a direct, rules-enforced read
    // is safe because it can't corrupt state, only leak it if mis-scoped —
    // hence the extra care in the helper functions.
    function isSignedIn() {
      return request.auth != null;
    }
    function claimRole() {
      return request.auth.token.role;
    }
    function claimCountries() {
      return request.auth.token.countries;
    }
    function claimEntities() {
      return request.auth.token.entities;
    }
    // Mirrors permissions.ts GLOBAL_VISIBILITY_ROLES minus 'executive' (aggregated
    // dashboards only, never raw case content) and minus 'system_admin' (section 30
    // of the brief: "System Administrator ≠ Case Access" — least privilege).
    function hasGlobalCaseVisibility() {
      return claimRole() in ['functional_admin', 'darc_compliance', 'consultation'];
    }
    function isInScope(kase) {
      return (claimCountries().size() == 0 || kase.country in claimCountries())
        && (claimEntities().size() == 0 || kase.entity in claimEntities());
    }
    function isAssignedTo(kase) {
      return request.auth.uid == kase.assignee || request.auth.uid in kase.additionalInvestigators;
    }
    // Rule #9 of the brief: a person implicated in a report must NEVER access
    // that case, regardless of role, assignment, or scope.
    function isNotImplicated(kase) {
      return !(request.auth.uid in kase.implicatedUserIds);
    }
    // === AMÉLIORATION AJOUTÉE : confidentiality clearance now mirrored into rules ===
    // Was previously enforced ONLY in src/domain/permissions.ts (can() ->
    // isConfidentialityAllowed), and not in these rules — a real, documented
    // gap (see docs/PERMISSIONS.md history / docs/SECURITY.md). Mirrors
    // ROLE_MAX_CONFIDENTIALITY / CONFIDENTIALITY_RANK exactly, field-for-field,
    // so client and rules can never diverge on this again. `restricted` <
    // `confidential` < `highly_confidential`, matching CONFIDENTIALITY_RANK.
    function confidentialityRank(level) {
      return level == 'highly_confidential' ? 3 : (level == 'confidential' ? 2 : 1);
    }
    // Mirrors ROLE_MAX_CONFIDENTIALITY. reporter/system_admin have no case
    // permission at all (see permissions.ts), so their rank value here is
    // moot in practice — kept at the lowest rank (1) rather than 0 so this
    // function has no undefined/null case to handle in rules syntax.
    function maxConfidentialityRank() {
      return claimRole() in ['senior_investigator', 'functional_admin', 'darc_compliance']
        ? 3
        : (claimRole() in ['investigator', 'consultation'] ? 2 : 1);
    }
    function isConfidentialityAllowed(kase) {
      return confidentialityRank(kase.confidentialityLevel) <= maxConfidentialityRank();
    }

    // === IMPORTANT (Phase 4 finding, verified live) ===
    // `allow read` below covers GET of one known caseId correctly (verified:
    // 6 live scenarios in Phase 3, all passing). It does NOT make `list`
    // (an unconstrained "give me every case I can see") work: Firestore
    // requires a list query's rule to be PROVABLE against the query's own
    // `where` filters alone, for every document it could possibly return —
    // it will not evaluate the rule per-document and silently drop denied
    // ones. Since `isNotImplicated`/`isInScope`/`isAssignedTo` all read
    // fields (`implicatedUserIds`, `country`, `entity`, `assignee`,
    // `additionalInvestigators`) that aren't part of any query filter, list
    // requests against `cases` are rejected outright (confirmed: even
    // `functional_admin`, who trivially passes every other check, gets
    // `403 Missing or insufficient permissions` on a plain `list`).
    // This is not a bug to fix in rules — it's exactly why
    // docs/ARCHITECTURE.md puts "list my cases" behind a Cloud Function
    // (server-side, Admin SDK, arbitrary filtering) rather than a raw
    // client query: weakening isNotImplicated to make listing "provable"
    // would mean trading away rule #9 of the brief (a person implicated in
    // a case must never access it), which is not a call to make silently
    // in a rules file. See docs/FIREBASE-SETUP.md.
    match /cases/{caseId} {
      allow read: if isSignedIn()
        && isNotImplicated(resource.data)
        && isInScope(resource.data)
        && isConfidentialityAllowed(resource.data)
        && (hasGlobalCaseVisibility() || isAssignedTo(resource.data));
      allow write: if false; // see note above — Cloud Functions only

      // Child collections (allegations, persons, evidence, tasks, interviews,
      // investigation_notes, communications, corrective_actions,
      // risk_assessments, timeline): GET of one known document id is
      // readable under the exact same authorization as the parent case
      // (fetched via get(), since a subcollection rule's `resource` is the
      // child document, not the parent). `list` on a subcollection hits the
      // identical provability wall as above (confirmed live) — even though
      // the get() call is constant for the whole subcollection, Firestore's
      // rule analyzer does not treat that as query-provable, so listing
      // still requires a Cloud Function. Two further gaps intentionally NOT
      // closed yet, flagged rather than ignored:
      // - Evidence.confidentiality ('restricted' items) has no extra check
      //   here — every migrated demo item is 'standard', so this doesn't
      //   currently leak anything, but a real 'restricted' item would need
      //   an additional per-document rule before this can be trusted as-is.
      // - This still does not give reporters a path to their own case at
      //   all (by design) — that remains Cloud-Function-only (section 44).
      // Writes stay closed — Cloud Functions only, same as the parent case.
      match /{subcollection}/{docId} {
        allow read: if isSignedIn()
          && isNotImplicated(get(/databases/$(database)/documents/cases/$(caseId)).data)
          && isInScope(get(/databases/$(database)/documents/cases/$(caseId)).data)
          && isConfidentialityAllowed(get(/databases/$(database)/documents/cases/$(caseId)).data)
          && (hasGlobalCaseVisibility() || isAssignedTo(get(/databases/$(database)/documents/cases/$(caseId)).data));
        allow write: if false;
      }
    }

    match /reporter_credentials/{caseId} {
      allow read, write: if false; // Cloud Function only — never exposed to any client, staff included.
    }

    match /reporter_identities/{caseId} {
      allow read, write: if false; // Cloud Function only — explicit, audited access (section 44 of the brief).
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    // === AMÉLIORATION AJOUTÉE ===
    // Server-tracked rate-limit counters for getCaseForReporter (Cloud
    // Function only — see functions/src/index.ts). Closed exactly like
    // `counters/*`: a client resetting or reading its own lockout state
    // would defeat the point of a server-side rate limit.
    match /rate_limits/{key} {
      allow read, write: if false;
    }
  }
}
