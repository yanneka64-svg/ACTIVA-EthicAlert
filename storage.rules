rules_version = '2';

// ACTIVA Hotline — Cloud Storage Security Rules (Evidence uploads)
//
// === AMÉLIORATION AJOUTÉE ===
// STATUS: written, NOT provisioned. Verified directly against the real
// project (activa-ethicalert-47246): its default Storage bucket does not
// exist yet (`storage.googleapis.com` returns 404 "bucket does not exist")
// and the Cloud Storage for Firebase API itself is SERVICE_DISABLED —
// confirmed by a direct API call, not assumed. This is a harder wall than
// the undeployed Cloud Functions: those are merely undeployed, this
// project has no Storage bucket at all. Since October 2024 a NEW default
// Storage bucket requires the Blaze plan — the exact same wall documented
// in docs/FIREBASE-SETUP.md for Cloud Functions, and the same "stay on
// Spark" decision applies here without needing to be re-litigated.
//
// Mirrors src/domain/permissions.ts's `can()` read-path logic for
// evidence.read / cases.edit, the same way firestore.rules does — but
// duplicated by necessity: Storage Security Rules and Firestore Security
// Rules are two separate rule languages/services that cannot share
// function definitions. If firestore.rules' equivalent logic ever
// changes, this file must be updated to match by hand; nothing enforces
// that automatically. Flagged here rather than left as a silent
// assumption of staying in sync.
//
// Design: evidence bytes live at evidence/{caseId}/{evidenceId}/{fileName}.
// Direct reads are always denied — Evidence.storagePath's own comment in
// caseTypes.ts commits to "resolved through a signed, short-lived, audited
// Cloud Function call" (see getEvidenceDownloadUrl in functions/src/index.ts),
// never a raw Storage URL, so `allow read` here is deliberately `if false`
// even for an otherwise-authorized user — the whole point is that nobody
// reads Storage directly, ever.
service firebase.storage {
  match /b/{bucket}/o {
    match /evidence/{caseId}/{evidenceId}/{fileName} {
      function isSignedIn() {
        return request.auth != null;
      }
      function claimRole() {
        return request.auth.token.role;
      }
      function claimCountries() {
        return request.auth.token.countries;
      }
      function claimEntities() {
        return request.auth.token.entities;
      }
      // Cross-service read of the parent Case document — mirrors
      // firestore.rules' own subcollection pattern (a get() against the
      // parent case), using this project's actual named database ("default",
      // not the special "(default)" — see docs/FIREBASE-SETUP.md).
      function caseData() {
        return firestore.get(/databases/default/documents/cases/$(caseId)).data;
      }
      function hasGlobalCaseVisibility() {
        return claimRole() in ['functional_admin', 'darc_compliance', 'consultation'];
      }
      function isInScope(kase) {
        return (claimCountries().size() == 0 || kase.country in claimCountries())
          && (claimEntities().size() == 0 || kase.entity in claimEntities());
      }
      function isAssignedTo(kase) {
        return request.auth.uid == kase.assignee || request.auth.uid in kase.additionalInvestigators;
      }
      function isNotImplicated(kase) {
        return !(request.auth.uid in kase.implicatedUserIds);
      }
      function confidentialityRank(level) {
        return level == 'highly_confidential' ? 3 : (level == 'confidential' ? 2 : 1);
      }
      // === AMÉLIORATION AJOUTÉE : repli corrigé après une revue de sécurité ===
      // Previously fell back to rank 1 for any role outside the two lists —
      // the same mistake firestore.rules' maxConfidentialityRank() had (see
      // that file's own comment and docs/SECURITY.md). Corrected the same
      // way here: no-case-access roles get rank 0, 'executive' its own
      // explicit rank-1 branch.
      function maxConfidentialityRank() {
        return claimRole() in ['senior_investigator', 'functional_admin', 'darc_compliance']
          ? 3
          : (claimRole() in ['investigator', 'consultation']
            ? 2
            : (claimRole() == 'executive' ? 1 : 0));
      }
      // === AMÉLIORATION AJOUTÉE : nom corrigé, sans vérification de rôle avant une revue de sécurité ===
      // This used to be named canEditCase() and was used directly as the
      // write-authorization check — but it only ever mirrored the READ
      // path (signed-in ∧ not-implicated ∧ in-scope ∧ confidentiality ∧
      // assigned-or-global), never checking that the caller's role
      // actually holds 'evidence.upload' in permissions.ts. That let
      // read-only roles (`consultation`, and `darc_compliance`, which has
      // `evidence.read` but not `evidence.upload`) overwrite evidence
      // files outright — a real, confirmed finding (docs/SECURITY.md).
      // Kept as isCaseAccessible() (the read-mirroring part alone, still
      // useful/correct on its own) and combined with an explicit role
      // check below for the actual write gate.
      function isCaseAccessible(kase) {
        return isSignedIn()
          && isNotImplicated(kase)
          && isInScope(kase)
          && confidentialityRank(kase.confidentialityLevel) <= maxConfidentialityRank()
          && (hasGlobalCaseVisibility() || isAssignedTo(kase));
      }
      // Mirrors ROLE_PERMISSIONS's actual 'evidence.upload' holders in
      // permissions.ts: investigator, senior_investigator, functional_admin
      // only — NOT darc_compliance (evidence.read only) or consultation
      // (read-only role entirely), even though both are in
      // hasGlobalCaseVisibility() above.
      function hasEvidenceUploadPermission() {
        return claimRole() in ['investigator', 'senior_investigator', 'functional_admin'];
      }
      function canUploadEvidence() {
        return hasEvidenceUploadPermission() && isCaseAccessible(caseData());
      }

      // Never a direct read — see header comment. All evidence access goes
      // through getEvidenceDownloadUrl (audited, short-lived signed URL).
      allow read: if false;

      // === AMÉLIORATION AJOUTÉE : écriture non destructive après une revue de sécurité ===
      // `resource == null` is true only when no object exists yet at this
      // path — so this allows a brand-new upload but denies overwriting an
      // existing one (a caller with genuine evidence.upload rights could
      // otherwise silently replace evidence an investigator has already
      // downloaded/hashed) AND denies deletion (a delete request has no
      // existing-object-is-null case to satisfy). Evidence removal is
      // modelled as `Evidence.status = 'deleted'` in Firestore, not by
      // actually deleting the Storage object — intentional, not an
      // oversight. Same 25MB cap as before (arbitrary but explicit).
      allow write: if canUploadEvidence() && resource == null && request.resource.size < 25 * 1024 * 1024;
    }

    // Everything else: closed. No public bucket browsing, no forgotten path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
